# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.sqlite binary
*.bin binary
*.ico binary
*.png binary
